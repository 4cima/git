# Turso Database (Server-side only - NO NEXT_PUBLIC_)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Supabase (Auth Only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# TMDB API Keys (for ingestion scripts)
TMDB_API_KEY=your_tmdb_api_key
TMDB_API_KEY_2=your_second_tmdb_key_optional

# AI API Keys (for translation/generation)
GROQ_API_KEY=your_groq_api_key

# OpenRouter (backup)
OPENROUTER_API_KEY_1=your_openrouter_key_1
OPENROUTER_API_KEY_2=your_openrouter_key_2
OPENROUTER_API_KEY_3=your_openrouter_key_3

# XAI
XAI_API_KEY=your_xai_key

# Mistral
MISTRAL_API_KEY=your_mistral_key

# Basic Auth for Admin Panel
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# Operations Panel Password (additional security layer for /admin/operations)
OPERATIONS_PANEL_PASSWORD=your_secure_operations_password

# Cloudflare Worker API (Backend for embed proxy)
NEXT_PUBLIC_API_URL=https://your-worker.workers.dev
NEXT_PUBLIC_WORKER_URL=https://your-worker.workers.dev

# On-demand revalidation secret (for POST /api/revalidate)
REVALIDATE_SECRET=your_revalidate_secret

# Base URL for the site (used for metadata, revalidation, etc.)
NEXT_PUBLIC_BASE_URL=https://4cima.com
