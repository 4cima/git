# Cloudflare D1 (production database)
# Database ID: <your-d1-database-id> (from Cloudflare dashboard > D1)
CLOUDFLARE_ACCOUNT_ID=<your-cloudflare-account-id>
CLOUDFLARE_DATABASE_ID=<your-d1-database-id>
# توكن بصلاحية D1:Edit — مطلوب للتطوير المحلي (next dev) وللسكربتات
#   • أنشئه من: My Profile › API Tokens › Create Token
#     الصلاحية: Account › D1 › Edit   (Account Resources: نفس الأكاونت أدناه)
#   • الإنتاج على Workers لا يحتاجه وقت التشغيل (يستخدم DB binding من wrangler.jsonc)،
#     لكن src/lib/sitemap.ts يقرأه كشبكة أمان لو غاب الـbinding.
#   • التوكنات تُلغى إذا انتهت مدتها أو التقطها فحص التسريبات — لو ظهر 401:
#     npm run check:d1
CLOUDFLARE_D1_TOKEN=
# توكن بصلاحية Workers Scripts:Edit + KV:Edit (للنشر اليدوي)
CLOUDFLARE_API_TOKEN=

# TMDB API Keys (for ingestion scripts)
TMDB_API_KEY=
TMDB_API_KEY_BACKUP=

# Base URL for the site (used for metadata, revalidation, etc.)
NEXT_PUBLIC_BASE_URL=https://4cima.com
# On-demand revalidation secret (for POST /api/revalidate)
REVALIDATE_SECRET=

# Admin role: comma-separated emails granted admin (Google OAuth)
# ADMIN_EMAILS=admin@example.com

# Player bridge signing secret (HMAC-SHA256 for cross-domain token)
CLOUDFLARE_PLAYER_TOKEN=
