{
  "name": "4cima-full-stack",
  "version": "2.0.0",
  "description": "4CIMA Movies & TV Series - Full Stack Platform",
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/capture-build-sha.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "setup": "node scripts/services/local-db.js",
    "download-ids": "node scripts/0-download-ids.js",
    "fetch": "node scripts/1-fetch-and-enrich.js",
    "enrich": "node scripts/2-enrich-incomplete.js",
    "sync": "node scripts/3-sync-to-d1.js",
    "full-workflow": "npm run download-ids && npm run fetch && npm run sync",
    "check-secrets": "node scripts/check-secrets.js",
    "check:d1": "node scripts/check-d1.js",
    "setup-secrets": "node scripts/setup-secrets.js",
    "predeploy:production": "node scripts/check-secrets.js && node scripts/verify-build-secrets.js",
    "deploy:production": "npm run build:cloudflare && node -e \"const {execSync}=require('child_process');execSync('npx wrangler deploy',{cwd:process.cwd(),stdio:'inherit',env:{...process.env,OPEN_NEXT_DEPLOY:'true'}})\"",
    "build:cloudflare": "node -e \"fs.rmSync('.next',{recursive:true,force:true})\" && opennextjs-cloudflare build && node scripts/verify-build-secrets.js",
    "deploy:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --name 4cima-staging",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "keywords": [
    "tmdb",
    "movies",
    "tv-series",
    "nextjs",
    "streaming"
  ],
  "author": "4CIMA",
  "license": "MIT",
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "jose": "^6.2.9",
    "lucide-react": "^0.469.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-player": "^3.4.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "better-sqlite3": "^12.9.0",
    "cli-progress": "^3.12.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "p-limit": "^7.3.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "wrangler": "^4.124.0"
  }
}
