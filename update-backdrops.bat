@echo off
node -e "const {createClient}=require('@libsql/client');const Database=require('better-sqlite3');require('dotenv').config({path:'.env.local'});const t=createClient({url:process.env.TURSO_DATABASE_URL,authToken:process.env.TURSO_AUTH_TOKEN});const d=new Database('./data/4cima-local.db');const B=200;async function u(table,items,label){console.log(`\n${label}: ${items.length}`);let done=0;const start=Date.now();for(let i=0;i<items.length;i+=B){const batch=items.slice(i,i+B);const stmts=batch.map(item=>({sql:`UPDATE ${table} SET backdrop_path=? WHERE tmdb_id=?`,args:[item.backdrop_path,item.tmdb_id]}));try{await t.batch(stmts,'write');done+=batch.length;const pct=(done/items.length*100).toFixed(1);const rate=(done/((Date.now()-start)/1000)).toFixed(0);const eta=((items.length-done)/rate/60).toFixed(1);process.stdout.write(`\r ${pct}%% | ${done}/${items.length} | ${rate}/s | ${eta}m `);}catch(e){console.error(`\nError:${e.message}`);}}console.log(`\n✅ Done`);}async function main(){console.log('UPDATE backdrop_path\n');const m=d.prepare('SELECT tmdb_id,backdrop_path FROM movies WHERE backdrop_path IS NOT NULL AND backdrop_path!=\"\"').all();const s=d.prepare('SELECT tmdb_id,backdrop_path FROM tv_series WHERE backdrop_path IS NOT NULL AND backdrop_path!=\"\"').all();console.log('LOCAL:',m.length,'movies,',s.length,'series');if(m.length>0)await u('movies',m,'🎬 MOVIES');if(s.length>0)await u('tv_series',s,'📺 SERIES');const checkM=await t.execute('SELECT COUNT(*) as c FROM movies WHERE backdrop_path IS NOT NULL');const checkS=await t.execute('SELECT COUNT(*) as c FROM tv_series WHERE backdrop_path IS NOT NULL');console.log('\nTURSO:',checkM.rows[0].c,'movies,',checkS.rows[0].c,'series');d.close();}main().catch(e=>{console.error('ERROR:',e.message);d.close();process.exit(1);});"
