{
  "name": "4cima",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "4cima-db",
      "database_id": "b50ec43e-b6c9-4b4e-937d-9ac8d9c975e6"
    }
  ]
}
