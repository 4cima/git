{
  "name": "4cima",
  // الـentry الأصلي المولّد من OpenNext: .open-next/worker.js
  // الـwrapper ده بيضيف كاش الحافة (Cache API) قبل الـhandler — راجع src/edge-cache-worker.ts
  "main": "src/edge-cache-worker.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "4cima"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE",       "class_name": "DOQueueHandler"    },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "26313856681946f29245e95c121467ab"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "4cima-db",
      "database_id": "b50ec43e-b6c9-4b4e-937d-9ac8d9c975e6"
    }
  ],
  // بوابة استهلاك عالمية (عبر كل نسخ العامل) لواجهة البحث — 30 طلب/دقيقة/مفتاح
  // Rate Limiting API من كلاودفلير نفسها — محسوبة مركزيًا مش في ذاكرة كل نسخة
  "ratelimits": [
    {
      "name": "SEARCH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
